set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR aarch64)

file(GLOB TC_DIRS "$ENV{HOME}/toolchain/gcc-arm-11.2-*-aarch64-none-linux-gnu")
if(NOT TC_DIRS)
  message(FATAL_ERROR "aarch64 toolchain not found under $ENV{HOME}/toolchain/")
endif()
list(GET TC_DIRS 0 TC_DIR)
set(CMAKE_C_COMPILER "${TC_DIR}/bin/aarch64-none-linux-gnu-gcc")
set(CMAKE_CXX_COMPILER "${TC_DIR}/bin/aarch64-none-linux-gnu-g++")

set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)